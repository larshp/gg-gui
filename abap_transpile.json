{
  "input_folder": ["src", "output_converter"],
  "exclude_filter": [
    "\\.prog\\."
  ],
  "output_folder": "output",
  "converter": {
    "input_folder": ["src"],
    "output_folder": "output_converter"
  },
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "unknownTypes": "compileError",
    "addFilenames": true,
    "addCommonJS": true
  },
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui",
      "folder": "/deps/open-abap-gui",
      "files": ["/src/**", "/framework/**"]
    }
  ]
}
