{
  "global": {
    "files": "/src/**/*.*",
    "noIssues": ["/src/zgg_native_.*\\.prog\\.abap$"],
    "skipGeneratedGatewayClasses": true,
    "skipGeneratedPersistentClasses": true,
    "skipGeneratedFunctionGroups": true,
    "errorOnDuplicateFilenames": true
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui",
      "folder": "/deps/open-abap-gui",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": {
      "release": "open-abap",
      "language": "Normal"
    },
    "errorNamespace": "."
  },
  "rules": {
    "7bit_ascii": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "abapdoc": false,
    "no_dynamic_stuff": true,
    "db_operation_in_loop": true,
    "definitions_top": true,
    "description_empty": true,
    "double_space": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "ambiguous_statement": true,
    "align_pseudo_comments": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "omit_parameter_name": true,
    "exporting": true,
    "uncaught_exception": true,
    "cds_check_syntax": true,
    "cds_comment_style": true,
    "line_break_multiple_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "commented_code": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": true,
    "cyclomatic_complexity": true,
    "dangerous_statement": true,
    "change_if_to_case": false,
    "check_abstract": true,
    "check_subrc": false,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "class_attribute_names": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cds_field_order": true,
    "cds_legacy_view": true,
    "cds_naming": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "align_type_expressions": true,
    "allowed_object_naming": true,
    "allowed_object_types": true,
    "avoid_use": true,
    "check_comments": false,
    "align_parameters": true,
    "dynpro_checks": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "selection_screen_texts_missing": true,
    "unknown_types": true,
    "whitespace_end": true,
    "xml_consistency": true
  }
}
